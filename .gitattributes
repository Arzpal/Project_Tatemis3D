# Tatemis3D — normalización de texto + Git LFS para binarios (ticket T0.1)
#
# Regla: al repo va TEXTO (código, .meta, .asset, escenas en Force Text) y, vía LFS, los
# binarios pesados (arte, audio, vídeo, fuentes, nativas). Sin LFS, cada versión de un .fbx
# o un .psd se guarda entera en el historial y el clon crece para siempre.
#
# Ojo: LFS solo actúa sobre lo que se añade DESPUÉS de trackearlo. Lo ya commiteado sigue
# como blob normal hasta que se modifique (aquí solo un PNG de 24 KB del template de Unity).

# Auto detect text files and perform LF normalization
* text=auto

# ---------------------------------------------------------------- imágenes
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.bmp   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.dds   filter=lfs diff=lfs merge=lfs -text
*.iff   filter=lfs diff=lfs merge=lfs -text
*.pict  filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------- modelos 3D y animación
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.dae    filter=lfs diff=lfs merge=lfs -text
*.3ds    filter=lfs diff=lfs merge=lfs -text
*.max    filter=lfs diff=lfs merge=lfs -text
*.ma     filter=lfs diff=lfs merge=lfs -text
*.mb     filter=lfs diff=lfs merge=lfs -text
*.c4d    filter=lfs diff=lfs merge=lfs -text
*.lxo    filter=lfs diff=lfs merge=lfs -text
*.stl    filter=lfs diff=lfs merge=lfs -text
*.ztl    filter=lfs diff=lfs merge=lfs -text
*.abc    filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------- audio
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------- vídeo
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.avi   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text
*.mpg   filter=lfs diff=lfs merge=lfs -text
*.mpeg  filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------- fuentes
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------- binarios de Unity y nativas
*.cubemap      filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.dll    filter=lfs diff=lfs merge=lfs -text
*.so     filter=lfs diff=lfs merge=lfs -text
*.dylib  filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
*.a      filter=lfs diff=lfs merge=lfs -text
*.pdb    filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------- comprimidos y documentos
*.zip   filter=lfs diff=lfs merge=lfs -text
*.7z    filter=lfs diff=lfs merge=lfs -text
*.gz    filter=lfs diff=lfs merge=lfs -text
*.rar   filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------- YAML de Unity (texto, NO a LFS)
# Escenas y prefabs son texto (Asset Serialization = Force Text) para poder leerlos en diff.
# `-merge` evita que Git los fusione a ciegas: un merge automático de YAML de Unity corrompe la
# escena en silencio. Si algún día hacen falta merges de escena, configurar UnityYAMLMerge.
*.unity   -merge
*.prefab  -merge
